# WAJIB (untuk kirim email via Resend) - isi dengan domain yang SUDAH terverifikasi
# di akun Resend milik Anda. JANGAN isi 'kantongin.com' (bukan domain milik Anda).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_DOMAIN=

