# OPSIONAL (hanya untuk beralih ke jalur email Resend) - isi dengan domain yang
# SUDAH terverifikasi di akun Resend milik Anda. JANGAN isi 'kantongin.com'
# (bukan domain milik Anda). Ketiga variabel ini KOSONG = form kontak & sosial
# memakai jalur WhatsApp (lihat lib/wa.ts).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_DOMAIN=

